         "map": {"B,1": "soft_smooth", "B,2": "norm_smooth", "B,3": "hard_smooth",
                 "B,4": "soft_uneven", "B,5": "norm_uneven", "B,6": "hard_uneven",
                 "7,1": "soft_smooth", "7,2": "norm_smooth", "7,3": "hard_smooth",
                 "7,4": "soft_uneven", "7,5": "norm_uneven", "7,6": "hard_uneven"}},
        {"name": "info_button", "bytes": [5], "nibble": "low",
         "map": {"4": "off", "5": "short_press", "6": "long_press"}},
        {"name": "heated_grips", "bytes": [7], "nibble": "high",
         "map": {"C": "off", "D": "low", "E": "high"}},
        {"name": "ignition", "bytes": [7],
         "map": {"FF": "off", "DF": "on"},
         "_note": "Source claims D7(High Nibble) but lists whole-byte values FF/DF, and DF's high nibble D collides with heated_grips 'low'. Encoded as the whole byte. If heated_grips and ignition disagree on the bike, this pair is what to re-check."}
      ]

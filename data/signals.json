{
  "version": 1,
  "vehicle": "BMW R1200GS (K25)",
  "byte_base": 1,
  "_byte_base": "Which data[] index D1 refers to. 1 => D1 is data[0]. The source table uses D1..D7 and never D0 or D8, so this is ambiguous; if decoded values are nonsense (idle RPM should be ~1000-1100), set this to 0 so D1 becomes data[1].",
  "_extraction": "bytes[] is little-endian, least-significant first: (D3*256+D2) is bytes:[2,3]. nibble is 'high' or 'low'. value = raw*scale + offset. map keys are uppercase hex of the extracted value. deadband/min_ms suppress chatter on analog signals.",
  "frames": {
    "10C": {
      "name": "engine",
      "signals": [
        {"name": "throttle_valve_pct", "bytes": [1], "scale": 0.392156862, "unit": "%", "decimals": 1, "deadband": 1.0, "min_ms": 300},
        {"name": "rpm", "bytes": [2, 3], "scale": 0.25, "unit": "rpm", "decimals": 0, "deadband": 25, "min_ms": 500},
        {"name": "clutch_kill", "bytes": [4], "nibble": "high",
         "map": {"A": "clutch_in", "6": "clutch_out", "5": "kill_switch_on"}},
        {"name": "side_stand", "bytes": [5], "nibble": "high",
         "map": {"5": "up", "9": "down"}},
        {"name": "asc_abs", "bytes": [5], "nibble": "low",
         "map": {"5": "off", "6": "on"}},
        {"name": "throttle_pct", "bytes": [6], "scale": 0.392156862, "unit": "%", "decimals": 1, "deadband": 1.0, "min_ms": 300,
         "_note": "Source says D6(High Nibble) but gives DEC(D6)/255*100; /255 implies the whole byte, so the whole byte is used. Verify against throttle_valve_pct."}
      ]
    },
    "130": {
      "name": "lights",
      "signals": [
        {"name": "high_beam", "bytes": [6], "nibble": "low",
         "map": {"9": "on", "A": "off"}},
        {"name": "turn_signals", "bytes": [7],
         "map": {"CF": "off", "D7": "left", "E7": "right", "EF": "both"}}
      ]
    },
    "294": {
      "name": "front_wheel",
      "signals": [
        {"name": "abs", "bytes": [1], "nibble": "low",
         "map": {"5": "on", "B": "off"}},
        {"name": "front_wheel_speed_kmh", "bytes": [2, 3], "scale": 0.06, "unit": "km/h", "decimals": 1, "deadband": 0.5, "min_ms": 500,
         "_note": "Source gives this scale as approximate (~0.06); the rear equivalent on 2A8 is exact. Calibrate against GPS."},
        {"name": "front_distance_m", "bytes": [4, 5], "scale": 0.03775, "unit": "m", "decimals": 2, "deadband": 10, "min_ms": 2000},
        {"name": "brake_levers", "bytes": [6],
         "map": {"03": "off", "07": "front", "0B": "rear", "0F": "both",
                 "00": "off", "04": "front", "08": "rear", "0C": "both"},
         "_note": "Two encodings: static values (03/07/0B/0F) and, after two full wheel revolutions, in-motion values (00/04/08/0C). Both folded into one map since the values do not collide."}
      ]
    },
    "2A8": {

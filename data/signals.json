      "signals": [
        {"name": "rear_wheel_speed_kmh", "bytes": [2, 3], "scale": 0.06, "unit": "km/h", "decimals": 1, "deadband": 0.5, "min_ms": 500},
        {"name": "rear_distance_m", "bytes": [4, 5], "scale": 0.03775, "unit": "m", "decimals": 2, "deadband": 10, "min_ms": 2000}
